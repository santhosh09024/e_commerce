# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce

# JWT Security
JWT_SECRET=super_secret_jwt_key_ecom_production_2026
JWT_EXPIRE=30d

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=rzp_test_sample_secret_key
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret

# Cloudinary Image Storage (Optional - falls back to local /uploads if not set)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service (SMTP / Nodemailer)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_user
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@shopease.com
